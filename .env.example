# Copy to .env and set a real password. .env is gitignored.
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me

# Phase 3 only -- from the Cloudflare Zero Trust dashboard when you create
# the tunnel. Leave unset until you actually want public access.
CLOUDFLARE_TUNNEL_TOKEN=

# Dify chat bubble on the dashboard. Leave blank and no bubble appears.
# Get the token from a published Dify app: Publish -> Embed in website.
# Changing it needs `docker compose up -d --build api` (Vite bakes it in).
VITE_DIFY_TOKEN=
VITE_DIFY_URL=http://localhost
